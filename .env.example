# Supabase → Project Settings → API
# Kedua nilai ini aman berada di browser (anon key dibatasi oleh Row Level Security).
# JANGAN pernah memasukkan service_role key ke variabel VITE_*.
# Gunakan publishable key (sb_publishable_...) atau JWT dengan role anon.
# URL production wajib HTTPS; jangan menaruh rahasia lain di VITE_*.
VITE_SUPABASE_URL= 
VITE_SUPABASE_ANON_KEY= 
